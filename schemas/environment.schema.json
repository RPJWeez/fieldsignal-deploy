{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["application"],
  "properties": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workloads"],
      "properties": {
        "workloads": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,39}$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "replicas": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "resources": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "requests": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cpu": {
                          "type": "string"
                        },
                        "memory": {
                          "type": "string"
                        }
                      }
                    },
                    "limits": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "cpu": {
                          "type": "string"
                        },
                        "memory": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "envFromSecret": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                },
                "env": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "DATABASE_URL": {
                      "type": "string",
                      "minLength": 1
                    },
                    "DATABASE_USER": {
                      "type": "string",
                      "minLength": 1
                    },
                    "KAFKA_BOOTSTRAP_SERVERS": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
